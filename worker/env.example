# Set either ORCHESTRATOR_URL or ORCHESTRATOR_HOST. Do not use localhost on LAN workers.
ORCHESTRATOR_URL=
ORCHESTRATOR_HOST=192.168.1.10
ORCHESTRATOR_PORT=8000
WORKER_NODE_ID=
WORKER_ID_FILE=.worker_id
WORKER_DEVICE_TYPE=cpu
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_HEARTBEAT_INTERVAL_SECONDS=3
WORKER_RESOURCE_INTERVAL_SECONDS=5
WORKER_RECONNECT_INITIAL_SECONDS=2
WORKER_RECONNECT_MAXIMUM_SECONDS=60
WORKER_RECONNECT_MULTIPLIER=2
WORKER_REQUEST_TIMEOUT_SECONDS=15
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=tinyllama:latest
OLLAMA_INFERENCE_TIMEOUT_SECONDS=300
OLLAMA_KEEP_ALIVE=5m
